# ---------------------------------------------------------------------------
# Catalygn daily WhatsApp content service
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Gemini (free tier) ---------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_free_tier_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# --- OpsForge whatsapp-service (reused, unchanged) ------------------------
# Base URL of the running whatsapp-service. Docs: services/whatsapp-service
WHATSAPP_SERVICE_URL=http://127.0.0.1:4000
# Must equal SERVICE_SECRET in the whatsapp-service .env (docs: "All routes
# require Authorization: Bearer <SERVICE_SECRET>")
WHATSAPP_SERVICE_SECRET=the_same_service_secret_as_whatsapp_service

# --- Recipient ------------------------------------------------------------
# 9532977264 (India) normalizes to +919532977264
CATALYGN_RECIPIENT=9532977264
# Attribution ids for the whatsapp-service queue/webhook payload
CATALYGN_AGENCY_ID=catalygn
CATALYGN_CLIENT_ID=catalygn-authority

# --- Content playbook -----------------------------------------------------
# Path to the playbook markdown. Copy your catalygn.md next to this service,
# or set an absolute path.
CATALYGN_PLAYBOOK_PATH=./catalygn.md
# Path to the image catalogue JSON.
CATALYGN_IMAGES_PATH=./images.json
# Public booking link used as the CTA. Overrides any link in the playbook.
CATALYGN_BOOKING_URL=https://cal.com/catalygn/intro-call

# --- MongoDB (reuse the existing instance) --------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/catalygn

# --- Schedule -------------------------------------------------------------
# 5-field cron. "0 12 * * *" = 12:00 PM, Asia/Kolkata.
CRON_SCHEDULE=0 12 * * *
CRON_TIMEZONE=Asia/Kolkata
# Set to false to install the service without arming the daily schedule.
SCHEDULER_ENABLED=true

# --- API / ops ------------------------------------------------------------
PORT=4100
LOG_LEVEL=info
# Bearer token required by POST /run and POST /test
CATALYGN_ADMIN_SECRET=generate_a_long_random_admin_secret

# --- Delivery attempts ----------------------------------------------------
SEND_MAX_ATTEMPTS=3
SEND_BACKOFF_MS=2000
# 0 = no cap (send to any valid number). Recommended: 9532977264
SEND_TEST_ALLOWLIST=9532977264
