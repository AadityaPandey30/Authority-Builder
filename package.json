{
  "name": "catalygn-content-service",
  "version": "1.0.0",
  "private": true,
  "description": "Generates and sends one business-consulting WhatsApp post per day for Catalygn, via the OpsForge whatsapp-service /send endpoint.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:generate": "tsx src/scripts/generateOnly.ts",
    "send:now": "tsx src/scripts/sendNow.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.1",
    "node-cron": "^3.0.3",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
